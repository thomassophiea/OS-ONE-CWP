generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  /// Gateway redirect verified, portal rendered, guest has not acted yet.
  STARTED
  /// Guest accepted the terms; the approval URL has been issued to the browser.
  ACCEPTED
  /// Gateway confirmed the station moved into its authenticated role.
  AUTHORIZED
  /// Authorization was attempted and the gateway refused it.
  AUTH_FAILED
  /// Request reached the portal but was refused (bad signature, bad params).
  REJECTED
  /// The original destination failed sanitisation; guest sent to a safe page.
  BLOCKED_REDIRECT
  /// Internal failure while handling the session.
  ERROR
  /// Session outlived PORTAL_SESSION_TTL_SECONDS without completing.
  EXPIRED
  /// Station left the WLAN.
  DISCONNECTED
  /// An operator withdrew this guest's access while the session was live.
  REVOKED
}

/// How a guest's authorization came to exist.
enum GuestSource {
  /// The guest completed the captive portal consent flow.
  CAPTIVE_PORTAL
  /// An operator entered the MAC in AURA before (or without) the guest connecting.
  MANUAL
  /// Observed on the gateway without a matching portal session.
  GATEWAY
}

enum GuestAuthorizationStatus {
  /// Access is granted: the portal will approve this station on sight.
  ACTIVE
  /// An operator withdrew access. Retained for audit; never silently deleted.
  REVOKED
  /// `expiresAt` has passed.
  EXPIRED
}

/// The authorization ledger, keyed by station MAC.
///
/// `GuestSession` records what happened during one portal visit; this record is
/// the standing answer to "may this device use the guest network?". It is what
/// the portal consults on redirect and what AURA manages, so a manually added
/// MAC and a guest who came through the portal are the same kind of thing.
model GuestAuthorization {
  id          String                   @id @default(cuid())
  /// Canonical `aa:bb:cc:dd:ee:ff`. One standing authorization per device.
  macAddress  String                   @unique
  displayName String?
  email       String?
  phone       String?
  notes       String?
  source      GuestSource              @default(CAPTIVE_PORTAL)
  status      GuestAuthorizationStatus @default(ACTIVE)

  // ---- last known network context (portal-observed) ----
  ssid        String?
  wlan        String?
  gatewayHost String?
  apName      String?
  apSerial    String?
  siteId      String?

  // ---- lifecycle ----
  firstSeen     DateTime?
  lastSeen      DateTime?
  authorizedAt  DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedBy     String?
  createdBy     String?
  /// Most recent portal session for this device, when there is one.
  lastSessionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastSeen])
  @@index([expiresAt])
  @@index([source])
  @@index([status, lastSeen])
}

model GuestSession {
  /// Internal portal session id (also the value bound into the signed cookie).
  id     String        @id @default(cuid())
  status SessionStatus @default(STARTED)

  // ---- identity of the station and the gateway ----
  /// Station MAC, normalised to aa:bb:cc:dd:ee:ff.
  clientMac    String?
  /// Station MAC exactly as the gateway spelled it (needed for the callback).
  clientMacRaw String?
  clientIp     String?
  /// Peer address seen by the portal (Railway edge / X-Forwarded-For).
  sourceIp     String?
  userAgent    String?

  /// hwc_ip — the ECP callback host advertised by the gateway.
  gatewayHost  String?
  /// hwc_port — 80 or 443 depending on the role's "Use HTTPS connection" flag.
  gatewayPort  String?
  /// Opaque per-station token issued by the gateway; the callback credential.
  gatewayToken String?
  apMac        String?
  bssid        String?
  apName       String?
  apSerial     String?
  apLocation   String?

  // ---- WLAN context ----
  ssid        String?
  vns         String?
  /// WLAN index (the `wlan` parameter), required by the callback.
  wlan        String?
  vlan        String?
  /// Pre-authentication role name reported in the redirect.
  preAuthRole String?

  // ---- request provenance / replay control ----
  /// Hex X-Amz-Signature of the redirect that created this session. Unique, so
  /// a captured redirect URL cannot be replayed into a second session.
  redirectSignature String?   @unique
  redirectSignedAt  DateTime?
  redirectExpiresAt DateTime?
  /// Decoded gateway parameters, minus anything secret.
  gatewayParams     Json?
  /// Non-sensitive request headers, for audit.
  requestHeaders    Json?

  // ---- guest workflow ----
  originalDest        String?
  /// Destination after sanitisation; what we hand back to the gateway.
  sanitizedDest       String?
  destRejectionReason String?
  acceptedTerms       Boolean   @default(false)
  acceptedAt          DateTime?
  /// The second required tick, when the portal requires privacy terms.
  /// Null = the form did not ask (the setting was off for this session).
  privacyPolicyAccepted Boolean?
  /// The OPTIONAL marketing tick, as submitted. Null = not asked. A consent
  /// flag, not personal data — like acceptedTerms, it records a choice.
  marketingConsent Boolean?
  /// The guest chose "Secure Guest Access" on the consent form. Nothing about
  /// the authorization changes — this only decides where the confirmation page
  /// sends them afterwards, so the open path is untouched when it is false.
  onboardingRequested Boolean   @default(false)
  /// SHA-256 of the CSRF token issued with the consent form.
  csrfTokenHash       String?

  // ---- captive-assistant hand-off ----
  /// SHA-256 of a single-use token that re-establishes this session in a
  /// different browser.
  ///
  /// The OS captive-portal window and the real browser are separate
  /// applications with separate cookie stores, so a guest who moves from one to
  /// the other arrives with no session cookie at all. This token is the only
  /// thing that carries the session across that boundary; it is burnt on first
  /// use and dropped from the address bar immediately afterwards.
  handoffTokenHash String?   @unique
  handoffExpiresAt DateTime?
  handoffUsedAt    DateTime?
  /// Source address the hand-off was redeemed from, for audit only.
  handoffUsedIp    String?

  // ---- privacy ----
  /// Whether personal data from this guest may be written to storage.
  ///
  /// Set from the consent form and never afterwards. `false` means the guest
  /// ticked "Do not store my personal data", which this application treats as a
  /// prohibition rather than a preference: personal values are stripped before
  /// a write is issued, not deleted afterwards.
  ///
  /// Defaults to true so that every pre-existing row keeps its current meaning.
  personalDataAllowed Boolean   @default(true)
  /// When the guest made that choice. The choice itself is a compliance record
  /// and is not personal data; the values it protects are.
  privacyChoiceAt     DateTime?

  /// Guest-supplied field values, keyed by registry id.
  ///
  /// Written **only** when `personalDataAllowed` is true. When it is false this
  /// column is never populated — the values are used for the duration of the
  /// request and discarded, so the prohibited data is never in Postgres at all.
  guestFields Json?

  // ---- CAPPORT (RFC 8908) ----
  /// SHA-256 of this session's Captive Portal API token.
  ///
  /// RFC 8908 §4: "If the API server needs information about the client
  /// identity that is not otherwise visible to it, the URI provided to the
  /// client during provisioning SHOULD be distinct per client." This portal
  /// runs off-network, behind the site's NAT, so it cannot see a station's
  /// address — a per-client URI is the mechanism the RFC points at.
  ///
  /// Deliberately not the session cookie: this token is read-only. It can
  /// produce a captive-state document and nothing else — it cannot authorize,
  /// cannot reveal a credential, and never sets a cookie.
  ///
  /// **Not unique.** The token is derived from the station MAC, so every visit
  /// by the same device produces the same value — a unique index here made a
  /// guest's second connection fail outright, because the insert collided and
  /// the portal reported the session as unavailable. It identifies a *device*
  /// across visits, which is what the Captive Portal API needs to answer
  /// about, so the lookup takes the most recent session instead.
  capportTokenHash String?

  // ---- authorization exchange ----
  authorizationAttemptedAt DateTime?
  authorizedAt             DateTime?
  /// Free-form outcome label, e.g. GATEWAY_CONFIRMED / GATEWAY_REFUSED.
  authorizationResult      String?
  failureReason            String?
  /// Role the gateway reported after authorization, when observed.
  authorizedRole           String?

  // ---- lifecycle ----
  expiresAt      DateTime?
  disconnectedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  auditEvents  AuditEvent[]
  onboardings  OnboardingSession[]
  sponsorships SponsorshipRequest[]

  @@index([clientMac])
  @@index([gatewayToken])
  @@index([createdAt])
  @@index([status])
  @@index([authorizedAt])
  @@index([ssid])
  @@index([status, createdAt])
  // Operators need "how many guests exercised the storage control?" without a
  // full scan; it is the only question this flag is ever aggregated for.
  @@index([personalDataAllowed])
  @@index([capportTokenHash])
}

/// Lifecycle of one employee-sponsorship request.
///
/// `APPROVED` records the sponsor's decision, nothing more. The guest becomes
/// authorized through exactly the same mechanism as the consent flow — a
/// presigned `/ext_approval.php` URL fetched by the guest's own browser — and
/// that later step is what stamps the *session* `AUTHORIZED`. A sponsorship can
/// therefore be APPROVED while the guest never got online (they closed the
/// page, the session expired), and the two records deliberately say different
/// things.
enum SponsorshipStatus {
  /// Waiting for the sponsor to decide.
  PENDING
  /// The sponsor allowed the request.
  APPROVED
  /// The sponsor refused the request.
  DENIED
  /// `expiresAt` passed with no decision.
  EXPIRED
  /// Withdrawn — superseded by a newer request from the same session.
  CANCELLED
}

/// One guest's request to be vouched for by an employee.
///
/// The approval credential is a 32-byte random token that exists only inside
/// the emailed URL; this row keeps its SHA-256. The token authorizes reading
/// the review page and posting a decision — it can never authorize the guest
/// directly, because the network grant is issued to the *guest's* browser via
/// the session, not to whoever holds the token.
///
/// `guestName` / `guestEmail` are personal data and follow the session's
/// storage prohibition: under `personalDataAllowed = false` they are never
/// written, and the sponsor sees the request identified by network context
/// only. `sponsorEmail` is retained regardless — who vouched for a device is
/// operational audit data, the same class of fact as `GuestAuthorization.revokedBy`.
model SponsorshipRequest {
  id        String            @id @default(cuid())
  status    SponsorshipStatus @default(PENDING)
  /// SHA-256 hex of the emailed approval token. The raw token is never stored.
  tokenHash String            @unique

  sessionId String
  session   GuestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Station MAC at request time, canonical form. Kept denormalised so the
  /// audit question "which device was this for?" survives session pruning.
  clientMac String?

  /// What the guest typed about themselves — subject to the storage prohibition.
  guestName  String?
  guestEmail String?
  /// The employee asked to vouch. Validated against SPONSOR_ALLOWED_DOMAINS
  /// server-side before this row exists.
  sponsorEmail String

  // ---- network context snapshot, for the sponsor email and review page ----
  ssid   String?
  apName String?

  // ---- lifecycle ----
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Hard deadline for the decision, enforced server-side on every read.
  expiresAt DateTime

  /// When the request email was accepted by the transport.
  emailSentAt DateTime?
  /// First time the review page was opened. A mail scanner following the link
  /// lands here too, so this is telemetry, never evidence of human review.
  viewedAt DateTime?

  /// When the decision was made (either way).
  decidedAt  DateTime?
  approvedAt DateTime?
  deniedAt   DateTime?
  /// Peer address and user agent that posted the decision, for audit.
  decisionIp        String?
  decisionUserAgent String?

  /// When the presigned gateway approval URL was first handed to the waiting
  /// guest. The session's own `authorizedAt` records the grant itself.
  authorizationIssuedAt DateTime?

  /// Access duration the sponsor chose at approval, in seconds. Null means the
  /// network default (no ledger expiry beyond the WLAN's own timers). Applied
  /// as `GuestAuthorization.expiresAt = authorizedAt + duration` when the
  /// gateway confirms the grant — it bounds how long the standing authorization
  /// lasts, not a live session the gateway is already running.
  accessDurationSeconds Int?

  /// Bounded status-poll accounting, so an abandoned page cannot poll forever.
  checkCount Int @default(0)

  @@index([sessionId])
  @@index([status])
  @@index([clientMac])
  @@index([sponsorEmail])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([status, expiresAt])
}

/// Operator-managed portal configuration — the storage behind AURA's
/// "Cloud Captive Portal" configuration page.
///
/// One row (`id = "default"`). Every column is nullable on purpose: null means
/// "not managed here — fall back to the environment variable", so a deployment
/// with no row (or no value) behaves exactly as it did when env vars were the
/// only source. The environment stays the bootstrap and the floor; this row is
/// the operator overlay on top of it. Nothing here is a secret and nothing
/// here is personal data.
model PortalConfig {
  id String @id @default("default")

  // ---- employee sponsorship ----
  /// Master switch. Null = enabled whenever domains + email transport exist;
  /// false = force off even when configured; true = same as null (the
  /// transport requirement can never be overridden from here).
  sponsorshipEnabled Boolean?
  /// Comma-separated sponsor domains, overriding SPONSOR_ALLOWED_DOMAINS.
  sponsorAllowedDomains String?
  /// Optional comma-separated allowlist of exact sponsor addresses. Empty or
  /// null means any mailbox at an allowed domain may sponsor.
  sponsorAllowedAddresses String?
  sponsorshipTtlSeconds    Int?
  sponsorshipMaxPerSession Int?

  // ---- guest fields ----
  /// Comma-separated registry ids, overriding GUEST_FIELDS_ENABLED.
  guestFieldsEnabled  String?
  guestFieldsRequired String?

  // ---- secure guest access ----
  /// Operator switch for the secure-onboarding offer. Null or true = offered
  /// whenever a secure WLAN is configured and readable; false = force off.
  /// It can never conjure the offer without SECURE_WLAN_* configuration.
  secureAccessEnabled Boolean?

  // ---- acceptance policy ----
  /// How guests get on: 'open' (no page — authorized on join), 'terms'
  /// (consent page, no fields), 'form' (consent page + guest fields),
  /// 'sponsored' (an employee approves before the session opens). Null =
  /// derived from configuration: 'form' when fields are enabled, else 'terms'
  /// — which reproduces pre-existing behaviour exactly.
  accessPolicy String?

  // ---- identity (administrators see this; guests never do) ----
  displayName String?
  description String?

  // ---- look ----
  /// Hex like #4b449b. Validated server-side to clear 4.5:1 against white,
  /// because it paints the primary action a guest has to be able to read.
  brandColor String?
  /// 'left' | 'center' | 'right'. Null = center (today's rendering).
  brandAlignment String?
  /// True = "Powered by Extreme Platform ONE" footer; false = no footer line;
  /// null = the pre-existing portal-name line.
  brandFooterEnabled Boolean?
  /// Uploaded logo, served at /portal-assets/logo. Null = the bundled
  /// Extreme default. Capped at 100 KB / 500x200px, checked at upload time —
  /// this column is never written without having already passed that check.
  logoData       Bytes?
  logoMimeType   String?
  logoUpdatedAt  DateTime?
  /// Uploaded background, served at /portal-assets/background. Null = no
  /// background image (today's plain page). Capped at 5 MB; no dimension
  /// limit, per product direction ("background can be larger").
  backgroundData      Bytes?
  backgroundMimeType  String?
  backgroundUpdatedAt DateTime?

  // ---- language ----
  /// Comma-separated locale codes offered to guests. Null = all eight.
  localesEnabled String?

  // ---- legal & privacy ----
  /// Override for the terms shown on the consent page. Null = the localized
  /// default. An override is single-language and renders as plain text.
  termsText String?
  /// A second required tick ("privacy terms") on the consent form.
  privacyPolicyEnabled Boolean?
  privacyPolicyText    String?
  /// An OPTIONAL marketing-consent tick. Access is never conditional on it.
  marketingEnabled Boolean?
  marketingText    String?

  /// Who last wrote this, from the caller's X-Actor header. Audit only.
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditEvent {
  id        String        @id @default(cuid())
  sessionId String?
  session   GuestSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Machine-readable event name, e.g. REDIRECT_VERIFIED, AUTHORIZATION_ISSUED.
  action    String
  /// "info" | "warn" | "error" — lets an operator filter for failures.
  severity  String        @default("info")
  details   Json?
  createdAt DateTime      @default(now())

  @@index([sessionId])
  @@index([action])
  @@index([createdAt])
  @@index([severity])
}

/// Which secure-onboarding mechanism a guest was actually given.
///
/// The *user-facing* action is always "Set Up Secure Wi-Fi"; this records what
/// that resolved to for their platform, because the answer differs and the
/// difference is what limits what can be claimed afterwards.
enum OnboardingMethod {
  /// Server-generated Apple configuration profile (.mobileconfig).
  APPLE_PROFILE
  /// Standard Wi-Fi QR (`WIFI:`), scanned by another device or this one's camera.
  WIFI_QR
  /// Network name and passphrase shown for the guest to type in.
  MANUAL
  /// Downloadable Windows WLAN profile, imported with `netsh wlan add profile`.
  WINDOWS_PROFILE
}

/// Platform the onboarding page resolved for this device.
enum OnboardingPlatform {
  IOS
  IPADOS
  ANDROID
  MACOS
  WINDOWS
  OTHER
}

/// Lifecycle of a secure-onboarding attempt.
///
/// `COMPLETED` is reserved for the one state that can be *proved*: the gateway
/// reporting the same station MAC associated to the secure WLAN's service id.
/// Handing out a profile or drawing a QR code is not evidence that anything
/// joined anything.
enum OnboardingStatus {
  /// Offered to the guest; nothing requested yet.
  OFFERED
  /// The guest opened the secure setup page.
  STARTED
  /// An Apple (or Windows) configuration profile was generated and served.
  PROFILE_DOWNLOADED
  /// A Wi-Fi QR code was rendered.
  QR_DISPLAYED
  /// The credential was revealed for manual entry.
  MANUAL_SETUP_VIEWED
  /// The gateway reported this station on the secure WLAN.
  COMPLETED
  /// Provisioning could not be produced for this device.
  FAILED
  /// The onboarding window closed without a confirmed join.
  EXPIRED
}

/// One guest's attempt to move a device from the open guest WLAN onto the
/// secure WLAN.
///
/// Created only when the guest selects the secure workflow — a guest who takes
/// the open path never causes a row here. It deliberately holds **no**
/// credential material: the passphrase is fetched from the credential provider
/// at the moment a provisioning artifact is generated and is never persisted.
model OnboardingSession {
  id        String @id @default(cuid())
  /// SHA-256 of the opaque bearer token bound to this onboarding. The token
  /// itself lives only in an HttpOnly cookie and is never stored or logged.
  tokenHash String @unique

  /// The portal visit this grew out of. The guest is already authorized on the
  /// open WLAN by the time this exists.
  sessionId String?
  session   GuestSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  /// Standing guest-ledger row for the device, when there is one.
  guestId   String?

  clientMac    String?
  clientMacRaw String?
  clientIp     String?
  sourceIp     String?
  userAgent    String?

  platform       OnboardingPlatform @default(OTHER)
  /// "client-hints" when the browser told us, "user-agent" when it was parsed.
  platformSource String?

  /// WLAN the device is on now.
  sourceSsid         String?
  sourceWlan         String?
  /// WLAN we are trying to move it to.
  targetSsid         String
  /// Gateway service id of the target WLAN, used for join verification.
  targetServiceId    String?
  /// Which credential provider answered — `skynet-gateway` today, a PPSK
  /// provider later. Recorded so a session can be interpreted after the
  /// provider set changes.
  credentialProvider String

  method OnboardingMethod?
  status OnboardingStatus  @default(OFFERED)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  expiresAt          DateTime
  startedAt          DateTime?
  profileRequestedAt DateTime?
  qrDisplayedAt      DateTime?
  manualViewedAt     DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  failureReason      String?

  /// Gateway service id the station was actually observed on at completion.
  verifiedServiceId String?
  verifiedAt        DateTime?
  /// Bounded polling accounting, so a stuck page cannot hammer the gateway.
  lastCheckedAt     DateTime?
  checkCount        Int       @default(0)

  @@index([sessionId])
  @@index([clientMac])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([status, createdAt])
}
