# OS-ONE-CWP — external captive web portal for ExtremeCloud IQ Controller (XCC)
#
# Copy to .env for local development. NEVER commit a filled-in .env.
# On Railway these are set as service variables, not from a file.

# ---------------------------------------------------------------- database ---
# Dedicated Postgres for the captive portal. On Railway use a service
# reference so the value follows a password rotation automatically:
#   DATABASE_URL=${{PostgresCWP.DATABASE_URL}}
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ------------------------------------------------------------ application ---
# Public origin of this deployment, no trailing slash. Used to derive the host
# the gateway signs against — never taken from the Host header.
APP_BASE_URL=https://portal.example.com

# Path component of the ECP URL configured on the gateway. Must match exactly,
# because it is part of the signed canonical request.
ECP_PATH=/portal

# Comma-separated hosts this app will answer for. Defaults to APP_BASE_URL's
# host when unset.
ALLOWED_HOSTS=portal.example.com

# Set to "false" only if this app is exposed directly with no proxy in front.
TRUST_PROXY=true

NODE_ENV=production
LOG_LEVEL=info

# -------------------------------------------------------------- ECP / XCC ---
# Must match "Identity" on the gateway's pre-authentication role exactly.
XCC_IDENTITY=OS-ONE-CWP

# Must match "Shared Secret" on the same role exactly. Generate with:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
XCC_SHARED_SECRET=

# Hosts allowed as the ECP callback target (`hwc_ip` in the gateway redirect).
# A parent domain matches its subdomains; bare IPs must be listed exactly.
# This is the ONLY thing this allowlist governs — the guest's original
# destination is sanitised, not allowlisted.
XCC_ALLOWED_GATEWAY_HOSTS=apcp.ezcloudx.com

# Deprecated alias for XCC_ALLOWED_GATEWAY_HOSTS, honoured if the above is unset.
# ALLOWED_REDIRECT_DOMAINS=

# ------------------------------------------------------------- sessions -----
# Random 32+ byte secret used to sign the session cookie and CSRF tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# How long a portal session stays usable before the guest must reconnect.
PORTAL_SESSION_TTL_SECONDS=900

# Lifetime requested on the presigned /ext_approval.php URL handed to the browser.
ECP_APPROVAL_TTL_SECONDS=60

# Clock skew tolerated when verifying the gateway's redirect signature.
ECP_SIGNATURE_SKEW_SECONDS=300

# ---------------------------------------------------------------- admin -----
# Leave unset to disable /admin/sessions entirely (the default). When set, the
# views require ?k=<this value>.
ADMIN_TOKEN=
