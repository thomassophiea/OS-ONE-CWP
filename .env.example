# OS-ONE-CWP — external captive web portal for ExtremeCloud IQ Controller (XCC)
#
# Copy to .env for local development. NEVER commit a filled-in .env.
# On Railway these are set as service variables, not from a file.

# ---------------------------------------------------------------- database ---
# Dedicated Postgres for the captive portal. On Railway use a service
# reference so the value follows a password rotation automatically:
#   DATABASE_URL=${{PostgresCWP.DATABASE_URL}}
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ------------------------------------------------------------ application ---
# Public origin of this deployment, no trailing slash. Used to derive the host
# the gateway signs against — never taken from the Host header.
APP_BASE_URL=https://portal.example.com

# Path component of the ECP URL configured on the gateway. Must match exactly,
# because it is part of the signed canonical request.
ECP_PATH=/portal

# Comma-separated hosts this app will answer for. Defaults to APP_BASE_URL's
# host when unset.
ALLOWED_HOSTS=portal.example.com

# Set to "false" only if this app is exposed directly with no proxy in front.
TRUST_PROXY=true

NODE_ENV=production
LOG_LEVEL=info

# -------------------------------------------------------------- ECP / XCC ---
# Must match "Identity" on the gateway's pre-authentication role exactly.
XCC_IDENTITY=OS-ONE-CWP

# Must match "Shared Secret" on the same role exactly. Generate with:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
XCC_SHARED_SECRET=

# Hosts allowed as the ECP callback target (`hwc_ip` in the gateway redirect).
# A parent domain matches its subdomains; bare IPs must be listed exactly.
# This is the ONLY thing this allowlist governs — the guest's original
# destination is sanitised, not allowlisted.
XCC_ALLOWED_GATEWAY_HOSTS=apcp.ezcloudx.com

# Deprecated alias for XCC_ALLOWED_GATEWAY_HOSTS, honoured if the above is unset.
# ALLOWED_REDIRECT_DOMAINS=

# ------------------------------------------------------------- sessions -----
# Random 32+ byte secret used to sign the session cookie and CSRF tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# How long a portal session stays usable before the guest must reconnect.
PORTAL_SESSION_TTL_SECONDS=900

# Lifetime requested on the presigned /ext_approval.php URL handed to the browser.
ECP_APPROVAL_TTL_SECONDS=60

# Clock skew tolerated when verifying the gateway's redirect signature.
ECP_SIGNATURE_SKEW_SECONDS=300

# ---------------------------------------------------------------- admin -----
# Leave unset to disable /admin/sessions entirely (the default). When set, the
# views require ?k=<this value>.
ADMIN_TOKEN=

# -------------------------------------------------- employee sponsorship ----
# Every variable below is optional. With SPONSOR_ALLOWED_DOMAINS unset (or no
# usable email transport) the portal offers no sponsorship option and the open
# guest path is untouched. See docs/SPONSORSHIP.md.

# Email domains a sponsor may belong to, comma-separated, exact ASCII match.
# Phase 1: exactly one domain.
SPONSOR_ALLOWED_DOMAINS=extremenetworks.com

# How long a sponsor has to decide. Defaults to PORTAL_SESSION_TTL_SECONDS —
# an approval after the guest's session died cannot be redeemed anyway.
SPONSORSHIP_TTL_SECONDS=900

# Sponsorship requests one portal session may create.
SPONSORSHIP_MAX_PER_SESSION=3

# Status polls one request may consume before the waiting page goes quiet.
SPONSORSHIP_MAX_STATUS_CHECKS=300

# Optional: Teams (Workflows) or Slack incoming webhook. Each request posts a
# card with Allow/Deny link-buttons onto the review page — a second bell beside
# the email, best-effort, never load-bearing. Dialect auto-detected from the
# URL; force with SPONSOR_WEBHOOK_FORMAT=teams|slack.
# SPONSOR_WEBHOOK_URL=
# SPONSOR_WEBHOOK_FORMAT=

# ------------------------------------------------------------------ email ---
# Transport selection: "resend" needs RESEND_API_KEY; "smtp" needs SMTP_URL or
# SMTP_HOST; "console" writes the rendered message (approval URL included) to
# stdout and is the development default — in production it must be opted into
# by name. Unforced preference: resend, then smtp, then console (dev only).
#
# NOTE Railway blocks ALL outbound SMTP (587/465/2525 measured dead from the
# container, 2026-08-31). On Railway only the Resend HTTPS transport can
# actually deliver; SMTP is for hosts with an open SMTP path.
# EMAIL_TRANSPORT=resend
EMAIL_FROM=guest-portal@example.com

# Resend (https://resend.com — free tier: 3,000/month). Until a sending domain
# is verified there, the free tier sends only from onboarding@resend.dev and
# only to the account owner's address.
# RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev

# SMTP — either a single URL…
# SMTP_URL=smtp://user:password@smtp.example.com:587
# …or discrete settings. For local demos, Ethereal (https://ethereal.email)
# issues throwaway credentials programmatically:
#   curl -X POST https://api.nodemailer.com/user -H 'Content-Type: application/json' \
#     -d '{"requestor":"dev","version":"1"}'
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
